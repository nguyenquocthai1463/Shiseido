    }

    .pd-small-img:hover {
        opacity: .6;
    }

    .pd-big-img {
        display: none;
        margin: 20px 45px;
    }

    .pd-next, .pd-prev{
        cursor: pointer;
        position: absolute;
        font-size: 20px;
        color: #666;
        bottom: 8%;
    }

    .pd-next {
        right: 0;
    }

    .pd-right {
        width: 55%;
    }

    .pd-brand {
        font-size: 16px;
        color: #666;
        font-family: Arial,sans-serif;
    }

    .pd-name {
        font-size: 28px;
        font-family: Arial,Medium,sans-serif;
    }

    .pd-description span{
        font-size: 14px;
        color: #666;
    }

        .pd-description span a {
            text-decoration: underline;
            color: #666;
        }

    .dott {
        cursor: pointer;
        height: 20px;
        width: 20px;
        margin: 0 7px;
        border-radius: 50%;
        display: inline-block;
        transition: background-color 0.6s ease;
    }
    
</style>
